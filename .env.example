# Copia a .env antes de levantar: 'cp .env.example .env'
#
# Sin defaults para los secretos a proposito: mejor que el proceso falle rapido
# y claro a que arranque con una credencial conocida. Ver docs/08-infra-local.md.

# UID/GID del usuario del host, para que lo que se genere dentro de los
# contenedores no quede de root. Obtenlos con: id -u; id -g
HOST_UID=1000
HOST_GID=1000

# Base de datos
DB_NAME=starter
DB_USER=starter
DB_PASSWORD=cambiame

# Firma de sesion. SIN default: si falta, el proceso no arranca.
# Genera una con: openssl rand -base64 48
JWT_SIGNING_KEY=

# Cookies. En local no hay TLS, asi que va en false. En produccion, true.
COOKIE_SECURE=false

# La UI de exploracion de la API (/api/v1/docs). Nunca en produccion.
API_DOCS_ENABLED=true
