{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hero",
  "description": "La portada de una pagina: un titulo grande, una bajada y, si se quiere, un llamado a la accion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title"
  ],
  "properties": {
    "title": {
      "title": "Titulo",
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "subtitle": {
      "title": "Bajada",
      "type": "string",
      "maxLength": 300
    },
    "cta": {
      "title": "Llamado a la accion",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "title": "Texto del boton",
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "href": {
          "title": "Enlace",
          "description": "Una ruta del sitio, como /precios, o una direccion que empiece con https://. No vale //otro.com: lleva a otro sitio",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(/([^/\\\\\\s]|$)|https://)"
        }
      }
    }
  }
}
