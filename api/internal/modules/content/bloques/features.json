{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "features",
  "description": "Una lista de puntos, cada uno con su titulo y un texto corto.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "title": { "type": "string", "maxLength": 120 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "text": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
