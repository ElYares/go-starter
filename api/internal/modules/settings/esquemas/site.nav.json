{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Navegacion",
  "description": "Los enlaces del menu de la cabecera, en orden.",
  "type": "array",
  "maxItems": 8,
  "items": {
    "$ref": "#/$defs/enlace"
  },
  "$defs": {
    "enlace": {
      "title": "Enlace",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "title": "Texto",
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "href": {
          "title": "Enlace",
          "description": "Una ruta del sitio, como /precios, o una direccion que empiece con https://",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(/([^/]|$)|https://)"
        }
      }
    }
  }
}
