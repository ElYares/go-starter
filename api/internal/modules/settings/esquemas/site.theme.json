{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tema",
  "description": "El color de acento del sitio.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accent"
  ],
  "properties": {
    "accent": {
      "title": "Color de acento",
      "description": "Un color hexadecimal, como #2f6df6",
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    }
  }
}
